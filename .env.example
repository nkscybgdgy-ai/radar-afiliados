# ---------------------------------------------------------------------------
# Padrão = 100% local e sem custo. Nada aqui precisa ser preenchido para rodar.
# Para conectar serviços reais, siga LANCAMENTO.md.
# ---------------------------------------------------------------------------

# Fontes e serviços (mock/dev/pglite = local)
DATA_SOURCE=mock          # mock | shopee
AUTH_PROVIDER=dev         # dev | supabase
BILLING_PROVIDER=mock     # mock | asaas
DB_DRIVER=pglite          # pglite | postgres

# Trava de custo: com qualquer serviço real acima, o app recusa subir sem isto.
# Só mude para true no dia de conectar de verdade.
ALLOW_PAID_SERVICES=false

# Negócio
PLAN_PRICE_CENTS=3900     # R$ 39,00/mês
FREE_RADAR_LIMIT=10
FREE_SHEETS_PER_DAY=5

# Local
PGLITE_DIR=.data/pglite
AUTH_SECRET=dev-only-secret-change-me-0000
CRON_SECRET=dev-cron-secret
JOB_TIME=03:00            # horário do `npm run job:daily -- --watch`

# Só com os serviços reais (ver LANCAMENTO.md)
# DATABASE_URL=
# ASAAS_API_KEY=
# ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
# ASAAS_WEBHOOK_TOKEN=
